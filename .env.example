OPENAI_API_KEY=
SERPER_API_KEY=
RESEARCH_MODEL=openai/gpt-4.1-mini
# Optional: stronger analysis, writing and final review; increases API cost.
# If empty, all stages use RESEARCH_MODEL.
SYNTHESIS_MODEL=
# Existing user IDs with unlimited research. Set separately in each environment.
ADMIN_USER_IDS=
# Local development. Enable Secure cookies when serving over HTTPS.
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
